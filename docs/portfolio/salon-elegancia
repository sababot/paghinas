<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Salón Elegancia — Peluquería & Estética de Lujo · Madrid</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" href="../images/portfolio/salon-elegancia-logo.png">

<style>

/* ── VARIABLES ── */
:root {
  --black:      #0d0b09;
  --dark:       #181410;
  --mid:        #4e4035;
  --gold:       #c4a05a;
  --gold-light: #dfc089;
  --gold-pale:  #f0e0c0;
  --cream:      #f7f2eb;
  --off-white:  #fdfbf8;
  --text:       #2a2219;
  --muted:      #8a7d6e;
  --border:     rgba(196,160,90,0.22);
  --nav-h:      72px;
  --ease:       cubic-bezier(0.22,0.61,0.36,1);
  --px:         clamp(1.25rem, 6vw, 7rem);
  --py:         clamp(4rem, 8vw, 8rem);
}

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Raleway', sans-serif; background: var(--off-white); color: var(--text); overflow-x: hidden; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
button, input, select, textarea { font-family: inherit; }
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-thumb { background: var(--gold); }

/* ── GLOBAL IMAGE RULES ──
   All images within positioned containers fill their space fully.
   The gradient backgrounds behind them act as fallbacks/tints.
*/

/* Hero image */
.hero-right img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

/* Philosophy visual image */
.philosophy-visual-inner img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 0;
}

/* Gallery images */
.gallery-bg img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* Team photo images */
.team-photo-bg img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

/* Make sure all gradient containers are properly positioned for imgs */
.gallery-bg {
  position: absolute;
  inset: 0;
}

.team-photo-bg {
  position: absolute;
  inset: 0;
}

/* ── NAV ── */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 900;
  height: var(--nav-h);
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem;
  padding: 0 var(--px);
  background: rgba(253,251,248,0.94);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
  transition: box-shadow 0.3s;
}
.nav.scrolled { box-shadow: 0 6px 30px rgba(0,0,0,0.07); }

.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1rem, 2.2vw, 1.35rem);
  font-weight: 400; white-space: nowrap; flex-shrink: 0;
  display: flex; align-items: center; gap: 0.5rem;
}
.nav-logo-dot { width: 6px; height: 6px; background: var(--gold); border-radius: 50%; flex-shrink: 0; }

.nav-links {
  display: flex; gap: clamp(1.2rem, 2vw, 2.2rem);
  list-style: none; flex: 1; justify-content: center;
}
.nav-links a {
  font-size: 0.68rem; font-weight: 500;
  letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted);
  position: relative; padding-bottom: 3px; transition: color 0.3s;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: 0; left: 50%; right: 50%;
  height: 1px; background: var(--gold);
  transition: left 0.3s var(--ease), right 0.3s var(--ease);
}
.nav-links a:hover { color: var(--gold); }
.nav-links a:hover::after { left: 0; right: 0; }

.nav-cta {
  flex-shrink: 0; white-space: nowrap;
  display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.6rem 1.4rem;
  font-size: 0.65rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
  background: var(--dark); color: var(--gold-pale);
  border: 1px solid transparent; transition: all 0.3s;
}
.nav-cta:hover { background: transparent; color: var(--gold); border-color: var(--gold); }

/* hamburger — hidden on desktop */
.hamburger {
  display: none;
  flex-direction: column; justify-content: center; gap: 5px;
  width: 40px; height: 40px;
  background: none; border: none; cursor: pointer; padding: 6px; flex-shrink: 0;
}
.hamburger span {
  display: block; width: 100%; height: 1.5px; background: var(--dark);
  transition: transform 0.35s var(--ease), opacity 0.25s;
}

/* ── MOBILE MENU OVERLAY ── */
.mobile-menu {
  display: none;
  position: fixed; inset: 0; z-index: 950;
  background: var(--dark);
  flex-direction: column; align-items: center; justify-content: center;
  gap: 0;
  opacity: 0; visibility: hidden;
  transition: opacity 0.4s var(--ease), visibility 0.4s;
}
.mobile-menu.is-open {
  opacity: 1; visibility: visible;
}
.mobile-menu-close {
  position: absolute; top: 1.5rem; right: 1.5rem;
  width: 48px; height: 48px;
  background: none; border: none; cursor: pointer;
  color: var(--gold-pale); font-size: 1.4rem;
  display: flex; align-items: center; justify-content: center;
}
.mobile-menu a {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 8vw, 3.2rem);
  font-style: italic; font-weight: 400;
  color: rgba(240,224,192,0.55);
  padding: 0.5rem 2rem; text-align: center;
  transition: color 0.3s;
}
.mobile-menu a:hover { color: var(--gold-light); }
.mobile-menu-divider { width: 1px; height: 28px; background: rgba(196,160,90,0.15); margin: 0.2rem auto; }
.mobile-menu-cta {
  margin-top: 2rem !important; font-family: 'Raleway', sans-serif !important;
  font-size: 0.7rem !important; font-style: normal !important;
  font-weight: 600 !important; letter-spacing: 0.2em;
  text-transform: uppercase; color: var(--gold) !important;
  border: 1px solid var(--gold); padding: 0.9rem 2.2rem !important;
  display: inline-flex !important; align-items: center; gap: 0.5rem;
  transition: background 0.3s, color 0.3s !important;
}
.mobile-menu-cta:hover { background: var(--gold) !important; color: var(--dark) !important; }

/* ── HERO ── */
.hero {
  padding-top: var(--nav-h);
  min-height: 100vh;
  display: grid;
  grid-template-columns: 55% 45%;
}

.hero-left {
  display: flex; flex-direction: column; justify-content: center;
  padding: clamp(2.5rem,5vw,5rem) var(--px) clamp(3rem,5vw,5rem);
}

.eyebrow {
  display: inline-flex; align-items: center; gap: 0.8rem;
  margin-bottom: clamp(1.5rem,3vw,2.5rem);
}
.eyebrow-line { width: 32px; height: 1px; background: var(--gold); flex-shrink: 0; }
.eyebrow-text { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold); }

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.6rem,5.2vw,5.4rem);
  font-weight: 400; line-height: 1.08; color: var(--dark);
  margin-bottom: clamp(1rem,2vw,1.8rem);
}
.hero-title em { font-style: italic; color: var(--gold); display: block; }

.hero-desc {
  font-size: clamp(0.83rem,1.1vw,0.93rem); font-weight: 300; line-height: 1.9;
  color: var(--muted); max-width: 420px; margin-bottom: clamp(2rem,3vw,3rem);
}

.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }

.hero-stats {
  display: flex; gap: clamp(1.5rem,3vw,3rem); flex-wrap: wrap;
  margin-top: clamp(2rem,4vw,4rem); padding-top: clamp(1.5rem,2.5vw,2.5rem);
  border-top: 1px solid var(--border);
}
.hero-stat-num {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.5rem,2.5vw,2.2rem); font-weight: 400; color: var(--dark); line-height: 1;
}
.hero-stat-label { font-size: 0.6rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 0.35rem; }

.hero-right {
  position: relative; overflow: hidden;
  background: linear-gradient(160deg, #c9b49a 0%, #dccfbe 45%, #b8a48e 100%);
  /* Ensure it spans full height of the hero */
  min-height: calc(100vh - var(--nav-h));
}
.hero-deco-ring {
  position: absolute; border: 1px solid rgba(196,160,90,0.25); border-radius: 50%;
  top: 50%; left: 50%; transform: translate(-50%,-50%);
  z-index: 1; pointer-events: none;
}
.hero-deco-ring:nth-child(1) { width: 68%; padding-top: 68%; margin: -34% 0 0 -34%; animation: spin 45s linear infinite; }
.hero-deco-ring:nth-child(2) { width: 94%; padding-top: 94%; margin: -47% 0 0 -47%; animation: spin 65s linear infinite reverse; }
.hero-icon { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); font-size: clamp(5rem,10vw,9rem); color: rgba(26,20,16,0.1); z-index: 1; }
.hero-badge {
  position: absolute; bottom: 2.5rem; left: 2.5rem; z-index: 2;
  background: var(--off-white); padding: 1.3rem 1.7rem;
  border-top: 3px solid var(--gold);
  box-shadow: 0 20px 50px rgba(0,0,0,0.15);
}
.hero-badge-num { font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--gold); line-height: 1; }
.hero-badge-label { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 0.35rem; line-height: 1.4; }

/* ── BUTTONS ── */
.btn {
  display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.9rem clamp(1rem,2.5vw,1.9rem);
  font-size: 0.68rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
  border: none; cursor: pointer; transition: all 0.35s var(--ease); white-space: nowrap; line-height: 1;
}
.btn i { font-size: 0.62rem; transition: transform 0.3s; }
.btn:hover i { transform: translateX(3px); }
.btn-dark { background: var(--dark); color: var(--gold-pale); }
.btn-dark:hover { background: var(--gold); color: var(--dark); }
.btn-outline { background: transparent; color: var(--mid); border: 1px solid var(--border); }
.btn-outline:hover { border-color: var(--gold); color: var(--gold); }
.btn-gold { background: var(--gold); color: var(--dark); }
.btn-gold:hover { background: var(--dark); color: var(--gold-pale); }

/* ── MARQUEE ── */
.marquee { background: var(--dark); padding: 1.2rem 0; overflow: hidden; }
.marquee-track {
  display: flex; width: max-content;
  animation: marquee 28s linear infinite;
}
.marquee-track:hover { animation-play-state: paused; }
.marquee-item {
  display: flex; align-items: center; gap: 0.7rem;
  padding: 0 2.2rem; white-space: nowrap;
  border-right: 1px solid rgba(196,160,90,0.18);
}
.marquee-item i { color: var(--gold); font-size: 0.7rem; }
.marquee-item span { font-size: 0.63rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(240,224,192,0.65); }

/* ── SECTION COMMONS ── */
.section { padding: var(--py) var(--px); }

.section-eyebrow { display: inline-flex; align-items: center; gap: 0.75rem; margin-bottom: 0.9rem; }
.section-eyebrow-line { width: 26px; height: 1px; background: var(--gold); flex-shrink: 0; }
.section-eyebrow-text { font-size: 0.62rem; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: var(--gold); }

.section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem,3.8vw,3.5rem); font-weight: 400; line-height: 1.1; color: var(--dark); }
.section-title em { font-style: italic; color: var(--gold); }
.section-title-light { color: var(--cream); }
.section-title-light em { color: var(--gold-light); }

/* scroll reveal */
.reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.75s var(--ease), transform 0.75s var(--ease); }
.reveal.in { opacity: 1; transform: none; }
.d1 { transition-delay: 0.1s; } .d2 { transition-delay: 0.2s; } .d3 { transition-delay: 0.3s; } .d4 { transition-delay: 0.4s; }

/* ── SERVICES ── */
.services-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(2.5rem,5vw,5rem); }
.services-intro-right { display: flex; flex-direction: column; align-items: flex-end; gap: 1rem; }
.services-intro-desc { font-size: 0.86rem; font-weight: 300; line-height: 1.9; color: var(--muted); text-align: right; max-width: 360px; }

.services-grid { display: grid; grid-template-columns: repeat(3,1fr); }
.service-card {
  padding: clamp(1.6rem,2.5vw,2.8rem) clamp(1.4rem,2vw,2.4rem);
  border: 1px solid var(--border); margin: -1px 0 0 -1px;
  position: relative; overflow: hidden;
}
.service-card::before {
  content: ''; position: absolute; inset: 0; background: var(--dark);
  transform: scaleY(0); transform-origin: bottom;
  transition: transform 0.5s var(--ease); z-index: 0;
}
.service-card:hover::before { transform: scaleY(1); }
.service-card > * { position: relative; z-index: 1; }
.sc-num { position: absolute; top: 1.3rem; right: 1.6rem; font-family: 'Playfair Display', serif; font-size: 0.75rem; color: var(--border); transition: color 0.4s; }
.service-card:hover .sc-num { color: rgba(196,160,90,0.25); }
.sc-icon { width: 48px; height: 48px; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 1rem; margin-bottom: 1.3rem; transition: border-color 0.4s; }
.service-card:hover .sc-icon { border-color: rgba(196,160,90,0.3); }
.sc-name { font-family: 'Playfair Display', serif; font-size: clamp(1rem,1.6vw,1.4rem); font-weight: 500; color: var(--dark); margin-bottom: 0.75rem; line-height: 1.25; transition: color 0.4s; }
.service-card:hover .sc-name { color: var(--cream); }
.sc-desc { font-size: 0.8rem; font-weight: 300; line-height: 1.85; color: var(--muted); margin-bottom: 1.3rem; transition: color 0.4s; }
.service-card:hover .sc-desc { color: rgba(240,224,192,0.55); }
.sc-footer { display: flex; align-items: center; justify-content: space-between; }
.sc-price { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-style: italic; color: var(--gold); }
.sc-arrow { width: 30px; height: 30px; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 0.65rem; transition: all 0.35s; }
.service-card:hover .sc-arrow { border-color: var(--gold); color: var(--gold); transform: translateX(3px); }

/* ── PHILOSOPHY ── */
.philosophy { padding: var(--py) var(--px); background: var(--dark); position: relative; overflow: hidden; }
.philosophy::before { content: ''; position: absolute; right: -80px; top: 50%; transform: translateY(-50%); width: 480px; height: 480px; border: 1px solid rgba(196,160,90,0.05); border-radius: 50%; pointer-events: none; }

.philosophy-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem,6vw,6rem); align-items: center; position: relative; }

/* Philosophy visual: fixed aspect-ratio container with image filling it */
.philosophy-visual {
  aspect-ratio: 4/5;
  background: linear-gradient(160deg,#3d3025 0%,#1e1712 100%);
  position: relative;
  overflow: hidden;
}
.philosophy-visual-inner {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end; /* push caption to bottom */
  justify-content: center;
  flex-direction: column;
}
/* The image fills the entire visual box */
.philosophy-visual-inner img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
/* Caption overlaid on image */
.philosophy-visual-inner p {
  position: relative;
  z-index: 2;
  font-family: 'Playfair Display', serif;
  font-size: clamp(0.85rem,1.4vw,1.05rem);
  font-style: italic;
  color: rgba(240,224,192,0.85);
  text-align: center;
  padding: 1.5rem 2rem;
  width: 100%;
  background: linear-gradient(to top, rgba(13,11,9,0.75) 0%, transparent 100%);
  line-height: 1.65;
}
/* Hide the standalone icon since image replaces it */
.philosophy-visual-inner > i {
  display: none;
}
.philosophy-frame { position: absolute; inset: 18px; border: 1px solid rgba(196,160,90,0.2); pointer-events: none; z-index: 3; }

.philosophy-content { padding: 1rem 0; }
.big-quote { font-family: 'Playfair Display', serif; font-size: 5rem; color: var(--gold); opacity: 0.18; line-height: 0.5; margin-bottom: 1.5rem; display: block; }
.philosophy-quote { font-family: 'Playfair Display', serif; font-size: clamp(1.1rem,1.8vw,1.55rem); font-style: italic; color: var(--cream); line-height: 1.55; margin-bottom: 1.8rem; }
.philosophy-body { font-size: 0.85rem; font-weight: 300; line-height: 1.9; color: rgba(240,224,192,0.45); margin-bottom: 2.5rem; }
.philosophy-pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.pillar { padding: 1.1rem; border: 1px solid rgba(196,160,90,0.13); }
.pillar i { color: var(--gold); font-size: 0.85rem; margin-bottom: 0.5rem; display: block; }
.pillar-name { font-size: 0.63rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-light); }

/* ── GALLERY ── */
.gallery-section { background: var(--cream); padding-bottom: 0; }
.gallery-header { padding: var(--py) var(--px) clamp(2.5rem,4vw,4rem); }
.gallery-grid { display: grid; grid-template-columns: repeat(12,1fr); grid-template-rows: 280px 240px; gap: 3px; }
.gallery-item:nth-child(1) { grid-column: 1/6; grid-row: 1/3; }
.gallery-item:nth-child(2) { grid-column: 6/9; grid-row: 1; }
.gallery-item:nth-child(3) { grid-column: 9/13; grid-row: 1; }
.gallery-item:nth-child(4) { grid-column: 6/10; grid-row: 2; }
.gallery-item:nth-child(5) { grid-column: 10/13; grid-row: 2; }
.gallery-item { position: relative; overflow: hidden; cursor: pointer; }
.gallery-bg { position: absolute; inset: 0; transition: transform 0.7s var(--ease); }
.gallery-item:hover .gallery-bg { transform: scale(1.06); }
.g1{background:linear-gradient(145deg,#5a4a3a,#2a1e14);}
.g2{background:linear-gradient(145deg,#8a7060,#4a3525);}
.g3{background:linear-gradient(145deg,#b8975a,#6a5535);}
.g4{background:linear-gradient(145deg,#3d3025,#1e1410);}
.g5{background:linear-gradient(145deg,#6b5d4a,#352a20);}
.gallery-overlay { position: absolute; inset: 0; background: linear-gradient(to top,rgba(13,11,9,0.75) 0%,transparent 55%); opacity: 0; transition: opacity 0.45s; display: flex; align-items: flex-end; padding: 1.5rem; z-index: 2; }
.gallery-item:hover .gallery-overlay { opacity: 1; }
.gallery-label { font-family: 'Playfair Display', serif; font-size: 0.95rem; font-style: italic; color: var(--cream); }
.gallery-deco { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: clamp(2rem,5vw,3.5rem); color: rgba(255,255,255,0.06); pointer-events: none; z-index: 1; }

/* ── TEAM ── */
.team-section { padding: var(--py) var(--px); }
.team-header { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1.5rem; margin-bottom: clamp(2.5rem,4vw,4rem); }
.team-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(1rem,2vw,1.8rem); }
.team-card {}
.team-photo {
  aspect-ratio: 3/4;
  overflow: hidden;
  position: relative;
  margin-bottom: 1.1rem;
}
/* team-photo-bg fills the card area */
.team-photo-bg {
  position: absolute;
  inset: 0;
  transition: transform 0.7s var(--ease);
}
.team-card:hover .team-photo-bg { transform: scale(1.05); }
.tp1{background:linear-gradient(180deg,#d4c4a8,#8a7060);}
.tp2{background:linear-gradient(180deg,#c2b09a,#6b5545);}
.tp3{background:linear-gradient(180deg,#ddd0ba,#9a8878);}
.tp4{background:linear-gradient(180deg,#c8ba9f,#7a6858);}
.team-photo-overlay { position: absolute; inset: 0; background: rgba(13,11,9,0); display: flex; align-items: center; justify-content: center; transition: background 0.45s; z-index: 2; }
.team-card:hover .team-photo-overlay { background: rgba(13,11,9,0.28); }
.team-photo-icon { font-size: 2rem; color: var(--gold-pale); opacity: 0; transform: scale(0.8); transition: opacity 0.4s, transform 0.4s; }
.team-card:hover .team-photo-icon { opacity: 1; transform: scale(1); }
.team-photo-label { position: absolute; bottom: 1.2rem; left: 0; right: 0; text-align: center; font-family: 'Playfair Display', serif; font-size: 0.75rem; font-style: italic; color: rgba(255,255,255,0.18); z-index: 2; }
.team-name { font-family: 'Playfair Display', serif; font-size: clamp(0.95rem,1.3vw,1.15rem); color: var(--dark); margin-bottom: 0.28rem; }
